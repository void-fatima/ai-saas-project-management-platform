# Copy to .env.production (ignored). Fill every blank required value.
# Use independently generated passwords; URL-encode them in the corresponding URLs.
POSTGRES_DB=platform
POSTGRES_USER=platform_migrator
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=
# postgresql://platform_app:ENCODED_APP_PASSWORD@postgres:5432/platform?schema=public
MIGRATION_DATABASE_URL=
# postgresql://platform_migrator:ENCODED_ADMIN_PASSWORD@postgres:5432/platform?schema=public
WEB_ORIGIN=https://app.example.com
WEB_PORT=8080
IMAGE_TAG=local
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_HOURS=168
SESSION_ROTATION_HOURS=24
SESSION_ABSOLUTE_HOURS=720
# SMTP is required for invitations, verification and password recovery.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=2048
