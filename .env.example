# Runtime
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000

# Browser-facing API base URL. Vite only exposes variables prefixed with VITE_.
VITE_API_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=project_platform
POSTGRES_USER=project_platform
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://project_platform:change-me-for-local-development@localhost:5432/project_platform?schema=public

# Authentication
SESSION_TTL_HOURS=168
SESSION_ROTATION_HOURS=24
SESSION_ABSOLUTE_HOURS=720

# DEVELOPMENT/TEST ONLY: messages are delivered to ignored .tools/mail/*.json.
# Production SMTP settings are documented in .env.production.example; disabled returns 503.
MAIL_MODE=development-file

# AI is opt-in. Set a structured-output-capable OpenAI model and server-only key.
AI_PROVIDER=disabled
# AI_MODEL=your-model-id
# AI_API_KEY=your-server-only-key
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=2048
