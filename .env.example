# Runtime
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Browser-facing API base URL. Vite only exposes variables prefixed with VITE_.
VITE_API_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=project_platform
POSTGRES_USER=project_platform
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://project_platform:change-me-for-local-development@localhost:5432/project_platform?schema=public

# Authentication
SESSION_TTL_HOURS=168
SESSION_ROTATION_HOURS=24
