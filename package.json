{
  "name": "ai-saas-project-management-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation for an AI-powered multi-tenant SaaS project management platform.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docker:config": "docker compose config --quiet",
    "db:up": "docker compose up -d postgres",
    "db:status": "docker compose ps postgres",
    "db:logs": "docker compose logs --tail 100 postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
