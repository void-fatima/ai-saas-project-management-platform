# Host Nginx example. Supply real certificate paths and replace app.example.com.
# Only this TLS edge should reach the loopback-published Compose web port.
server {
    listen 80;
    server_name app.example.com;
    access_log off;
    error_log /var/log/nginx/platform-error.log crit;
    return 301 https://app.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name app.example.com;
    ssl_certificate /etc/ssl/platform/fullchain.pem;
    ssl_certificate_key /etc/ssl/platform/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/platform-error.log crit;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
